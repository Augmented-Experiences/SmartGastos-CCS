{
  "identifier": "default",
  "description": "Permisos base para la ventana principal de SmartGastos.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "backend",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
